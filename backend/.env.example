# BioVision backend configuration.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value here is read through src/biovision/config.py -- nothing reads
# os.environ directly.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
BIOVISION_ENV=development                 # development | production
BIOVISION_LOG_LEVEL=INFO
# Every origin the browser will call this API from. A port not listed here fails
# as an opaque "Failed to fetch" in the console, with no CORS wording -- so if the
# frontend starts on 3001 because something else holds 3000, add it here too.
BIOVISION_CORS_ORIGINS=http://localhost:3000,https://biovision.bilalgurkansanli.com

# ---------------------------------------------------------------------------
# Model backend
# ---------------------------------------------------------------------------
# mock = deterministic stand-ins, no weights, no network. This is what CI runs and
#        what Sprint 1 ships. real = load actual checkpoints (Phase 3 onwards).
BIOVISION_MODEL_BACKEND=mock
BIOVISION_WEIGHTS_DIR=weights
BIOVISION_DOMAINS_FILE=src/biovision/domains/domains.yaml

# ---------------------------------------------------------------------------
# Thresholds
# ---------------------------------------------------------------------------
# Placeholders. Both are replaced by values derived in Phase 4 from the calibration
# split -- never hand-tuned against the test set.
BIOVISION_GATE_THRESHOLD=0.25
BIOVISION_ROUTER_MIN_CONFIDENCE=0.45

# Two specialist floors, because there are two questions and one threshold gets
# one of them wrong. 0.20 decides what is LISTED as a finding (instance F1 at
# IoU 0.5); 0.10 builds the damaged REGION (pixel coverage, which has a measured
# knee there). Both are reported to the client. README section 7.9.
BIOVISION_SPECIALIST_MIN_CONFIDENCE=0.20
BIOVISION_SPECIALIST_REGION_CONFIDENCE=0.10

# Locate the car, so damaged area is a fraction of the VEHICLE rather than of the
# photograph. Costs ~75 ms per request on CPU. False makes `area_ratio_vehicle`
# null everywhere and the response says the vehicle was not measured -- degraded,
# not broken.
BIOVISION_VEHICLE_EXTENT_ENABLED=true
BIOVISION_VEHICLE_EXTENT_CONFIDENCE=0.15

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
BIOVISION_MAX_UPLOAD_BYTES=10485760       # 10 MB
BIOVISION_MIN_IMAGE_DIMENSION=200
BIOVISION_STORED_LONG_EDGE=1280

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Must match the --workers the server runs with: the VLM budget is divided by it.
BIOVISION_UVICORN_WORKERS=2

BIOVISION_ANON_DAILY_LIMIT=20             # per IP, anonymous demo access
BIOVISION_USER_DAILY_LIMIT=100            # per authenticated user
# Comma-separated addresses exempt from the daily quota. Intended for the
# operator's own account so a demo cannot be cut off by its own limit.
# Does NOT exempt anyone from the monthly VLM budget -- that ceiling is about
# money leaving an account and applies to everybody.
BIOVISION_UNLIMITED_EMAILS=

# ---------------------------------------------------------------------------
# VLM fallback (Phase 6)
# ---------------------------------------------------------------------------
# Anonymous callers never reach the VLM: the fallback path requires sign-in, so
# unauthenticated traffic cannot spend the budget.
BIOVISION_VLM_ENABLED=false
BIOVISION_VLM_MODEL=claude-haiku-4-5
BIOVISION_VLM_MONTHLY_BUDGET_USD=5.00     # hard ceiling; 100% -> VLM off, 503
BIOVISION_VLM_BUDGET_WARN_RATIO=0.80      # 80% -> warning in the logs
BIOVISION_DEFAULT_LANGUAGE=tr             # Accept-Language overrides per request
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (Phase 7)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project JWT secret (Settings -> API -> JWT Settings). Access tokens are
# verified locally against this -- no network hop in the auth path.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=                # server-side only, never sent to a browser
SUPABASE_STORAGE_BUCKET=biovision-images
BIOVISION_RETENTION_DAYS=7                # blurred derivatives deleted after 7 days
