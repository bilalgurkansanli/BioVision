# --- Secrets: nothing matching these ever enters the repository ---
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# --- Model weights: downloaded by scripts/fetch_weights.py, never committed ---
backend/weights/
*.pt
*.onnx
*.safetensors

# --- Datasets: only manifests are committed (see docs/OPEN_QUESTIONS.md Q4) ---
data/**
!data/**/
!data/**/manifest.csv
# A review verdict is a manifest under another name, and NOTICE.md points a
# reader straight at it. It was excluded by accident.
!data/**/verdicts.csv
!data/**/README.md

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Runtime artifacts ---
*.log
.uploads/

# Evaluation images pulled from Wikimedia Commons. Not committed: the licences
# differ per file and attribution.csv records them, but redistributing the
# images themselves is a claim this project does not need to make.
data/_sources/vehicle_undamaged/
data/_sources/vehicle_clean/
data/_sources/konut/
weights/crack/
data/konut_eval/_candidates/
weights/konut/
metu_crack_patch.zip
# Kaggle upload staging. 24 MB of Wikimedia images with no per-file
# attribution travelling with them; verdicts.csv and fetch_commons.py are the
# reproducible record, and they are what the repository carries.
konut-intact-rooms.zip
