# Frontend configuration.
#
# Everything here is PUBLIC by construction: `NEXT_PUBLIC_*` values are inlined
# into the JavaScript the browser downloads. Nothing secret can live in this
# file, and nothing secret needs to -- the anon key grants no access on its own
# because every table is behind row-level security.
#
# The service-role key, the Supabase JWT secret, and the Anthropic key live on
# the VPS and are never referenced from this directory. A build that needed one
# of them would be a design error.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Without these the app runs in demo mode: analysis works, sign-in and
# history are unavailable, and the UI says so rather than failing at the first
# click.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
