# pnpm re-verifies the dependency tree before every `pnpm run`, and treats an
# unclassified dependency build script as a hard error -- so a skipped native
# build blocks typecheck, lint, and build alike.
#
# Both skipped builds are native binaries this app does not need (see
# pnpm-workspace.yaml for which and why), so the skip is the intended outcome.
# Turning the pre-run check off keeps `install` the only command that decides
# whether the tree is sound.
verify-deps-before-run=false
strict-dep-builds=false
