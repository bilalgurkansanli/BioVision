# Caddy obtains and renews the TLS certificate automatically, provided the DNS A
# record for this name already points at the box and ports 80/443 are reachable.

api.biovision.bilalgurkansanli.com {
	encode gzip

	# The upload limit is enforced twice on purpose. Caddy refuses an oversized
	# body before it reaches Python at all; the application still checks, because
	# the API must return its documented 413 envelope rather than a proxy error
	# page. Set slightly above the app limit so the app is what answers.
	#
	# The limit is a CLAIM, not a photograph. /v1/claims/photos accepts up to
	# MAX_CLAIM_PHOTOS (6) files of BIOVISION_MAX_UPLOAD_BYTES (10 MB) each, so a
	# legitimate request body reaches 60 MB. This was 12MB -- sized for the
	# single-photo endpoint and never revisited when the claim endpoint was added
	# -- which meant three phone photographs of one accident were refused by the
	# proxy with an HTML error page, and the application's clear 413 was never
	# reached. If either constant moves, this moves with it.
	request_body {
		max_size 62MB
	}

	# CPU inference on a machine with no GPU. The default proxy timeout would cut
	# a slow request off mid-inference; the ceiling here is deliberately above the
	# 3 s p95 that justifies staying synchronous, so a breach shows up as latency
	# in the metrics rather than as a truncated response.
	reverse_proxy api:8000 {
		# Overwrite rather than append. Caddy's default is to append the real
		# address to whatever the client sent, so a request carrying
		# `X-Forwarded-For: 1.2.3.4` arrives as `1.2.3.4, <real>`. An application
		# reading the leftmost entry then rate-limits on a value the caller
		# chooses -- which is exactly what happened here until an audit. The app
		# now reads the rightmost entry as well; both fixes are kept because
		# either one alone is a single line away from being undone by accident.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}

		transport http {
			read_timeout 30s
			write_timeout 30s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"

		# This host serves JSON and nothing else. A restrictive policy costs
		# nothing here and removes the API from the set of pages that can be
		# framed, scripted, or used to load anything.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Cross-Origin-Resource-Policy "same-site"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

		-Server
	}

	log {
		output file /data/access.log {
			roll_size 50MB
			roll_keep 5
		}
	}
}
